# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BUCKET_NAME=your-bucket-name

# BigQuery
BIGQUERY_DATASET_RAW=raw_cms_claims
BIGQUERY_DATASET_STAGING=staging_cms_claims
BIGQUERY_DATASET_CURATED=curated_cms_claims
BIGQUERY_DATASET_ANALYTICS=analytics_cms_claims
BIGQUERY_DATASET_ML=ml_outputs

# Data Generation Config
RANDOM_SEED=42
NUM_BENEFICIARIES=75000
NUM_PROVIDERS=1000

# Environment
ENVIRONMENT=development